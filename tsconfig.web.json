{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "tests/setup.ts",
    "tests/web/**/*.ts"
  ]
}
